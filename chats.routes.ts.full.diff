+  }>("/:chatId/messages/:messageId/illustration-receipts", async (req, reply) => {
+    const { chatId, messageId } = req.params;
+    const chat = await storage.getById(chatId);
+    const message = await storage.getMessage(messageId);
+    if (!chat || isHomeProfessorMariChat(chat) || message?.chatId !== chatId) {
+      return reply.status(404).send({ error: "Message not found" });
+    }
+    const requested = req.query.swipeIndex;
+    if (requested !== undefined && (!/^\d+$/.test(requested) || !Number.isSafeInteger(Number(requested)))) {
+      return reply.status(400).send({ error: "Invalid swipe index" });
+    }
+    const swipeIndex = requested === undefined ? message.activeSwipeIndex : Number(requested);
+    const swipe = (await storage.getSwipes(messageId)).find((row) => row.index === swipeIndex);
+    const receipts = parseExtra(swipe?.extra).illustratorPromptReceipts;
+    reply.header("Cache-Control", "no-store");
+    return {
+      swipeIndex,
+      receipts: Array.isArray(receipts)
+        ? receipts.map((receipt) => {
+            if (!Array.isArray(receipt?.attempts)) return receipt;
+            return {
+              ...receipt,
+              attempts: receipt.attempts.map((attempt: Record<string, unknown> | null) => {
+                if (!attempt) return attempt;
+                const { provider, pricingSource, tokensPrompt, tokensCompletion, tokensReasoning, tokensTotal } =
+                  attempt;
+                if (
+                  tokensPrompt === 0 &&
+                  tokensCompletion === 0 &&
+                  typeof tokensTotal === "number" &&
+                  tokensTotal > 0
+                ) {
+                  return { ...attempt, tokensPrompt: undefined, tokensCompletion: undefined };
+                }
+                if (
+                  provider !== "custom" ||
+                  pricingSource !== "vertex" ||
+                  typeof tokensPrompt !== "number" ||
+                  typeof tokensCompletion !== "number" ||
+                  typeof tokensReasoning !== "number" ||
+                  tokensReasoning <= 0
+                ) {
+                  return attempt;
+                }
+                // Some Vertex proxies return visible output and thoughts separately. The total resolves the
+                // format when present. On older receipts, thoughts larger than output prove they were separate.
+                const hasSeparateThoughts =
+                  typeof tokensTotal === "number"
+                    ? tokensTotal === tokensPrompt + tokensCompletion + tokensReasoning
+                    : tokensReasoning > tokensCompletion;
+                return hasSeparateThoughts
+                  ? { ...attempt, tokensCompletion: tokensCompletion + tokensReasoning }
+                  : attempt;
+              }),
+            };
+          })
+        : [],
+    };
+  });
