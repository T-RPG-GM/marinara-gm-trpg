+    const visible = new Set(visibleNames.map(bare));
+    shown = shown.filter(({ name }) => visible.has(bare(name)));
+  }
+  const missing = shown.filter(({ tags }) => !prompt.includes(tags));
+  if (!missing.length) return prompt;
+  return `${prompt}\n\n${missing.map(({ name, tags }) => `${name}'s Appearance: ${tags}`).join("\n")}`;
