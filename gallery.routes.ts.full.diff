+function novelAiRequestOptions(
+  imageDefaults: ImageGenRequest["imageDefaults"],
+  fallback: ImageGenRequest["fallback"],
+  overrides: z.infer<typeof novelAiOverridesSchema> | undefined,
+) {
+  if (!overrides) return { imageDefaults, fallback };
+  const apply = (profile: ImageGenRequest["imageDefaults"]) =>
+    profile?.service === "novelai"
+      ? { ...profile, novelai: { ...(profile.novelai ?? DEFAULT_NOVELAI_DEFAULTS), ...overrides } }
+      : profile;
+  return {
+    imageDefaults: apply(imageDefaults),
+    fallback: fallback ? { ...fallback, imageDefaults: apply(fallback.imageDefaults) } : undefined,
+  };
+}
