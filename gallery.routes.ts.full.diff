+/**
+ * Appends override tags as `Name's Appearance: tags` lines, the format Marinara's Illustrator uses,
+ * unless the prompt writer already copied them in.
+ */
+function withCoc7Appearances(
+  prompt: string,
+  appearances: Array<{ name: string; tags: string }> | undefined,
+  visibleNames: string[] | undefined,
+): string {
+  let shown = appearances ?? [];
+  // The prompt writer lists who is actually visible, so a person a scene only mentions ("띠니 is not home") stays out.
+  // Names match whole (a note in brackets aside), so 끄끼띠니 or 띠니의 어머니 never count as 띠니.
+  if (visibleNames?.length) {
+    const bare = (name: string) => name.replace(/[(（[].*?[)）\]]/gu, "").trim().toLowerCase();
+    const visible = new Set(visibleNames.map(bare));
+    shown = shown.filter(({ name }) => visible.has(bare(name)));
+  }
+  const missing = shown.filter(({ tags }) => !prompt.includes(tags));
+  if (!missing.length) return prompt;
+  return `${prompt}\n\n${missing.map(({ name, tags }) => `${name}'s Appearance: ${tags}`).join("\n")}`;
+}
